rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
// ATURAN FIRESTORE — pre-test BIMTEK eMonDAK (proyek bimtek-pfid)
//
// Koleksi yang dipakai
//   pretestAkun/{idAkun}    profil peserta (nama, email, pemda)
//   pretestSesi/aktif       jadwal & token sesi yang sedang berjalan
//   pretestHasil/{auto}     nilai akhir tiap peserta
//
// ───────────────────────────────────────────────────────────────────────────
// LANGKAH PEMASANGAN
//
//  1) AKUN PANITIA — Firebase Console → Authentication
//     a. Sign-in method → aktifkan penyedia "Email/Password".
//     b. Users → Add user → isi email dan kata sandi panitia.
//     Akun itulah yang dipakai masuk ke Ruang Admin (#/admin). Tidak ada
//     pendaftaran panitia dari dalam aplikasi.
//
//  2) DAFTAR EMAIL PANITIA — tulis email dari langkah 1 pada fungsi
//     emailAdmin() di bawah. Boleh lebih dari satu, pisahkan dengan koma.
//
//  3) ATURAN — Console → Firestore Database → Rules → hapus isinya →
//     tempel SELURUH berkas ini → Publish.
//     https://console.firebase.google.com/u/0/project/bimtek-pfid/firestore/rules
//
// ───────────────────────────────────────────────────────────────────────────
// PRINSIPNYA
//  - Peserta TIDAK memakai akun Firebase. Mereka mengetik email sendiri, dan
//    dokumennya boleh dibuat tanpa login — tetapi isinya diperiksa ketat.
//  - Nilai hanya boleh DIBUAT sekali. Mengubah nilai ditolak untuk semua
//    orang, termasuk panitia; yang boleh dilakukan panitia hanya menghapus
//    rekaman (mis. data uji coba atau peserta yang salah daftar).
//  - Sesi ujian — token, jadwal, tombol buka/tutup — hanya boleh ditulis
//    panitia yang sudah masuk. Itulah yang menjaga ujian tetap serentak.
//  - Catatan privasi: email peserta ikut tersimpan pada dokumen yang boleh
//    dibaca umum, karena papan peringkat membaca koleksi hasil. Bila email
//    dianggap sensitif, ubah `allow read: if true;` pada pretestHasil dan
//    pretestAkun menjadi `if isAdmin();` — konsekuensinya papan peringkat
//    hanya bisa dibuka panitia.
// ═══════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ┌───────────────────────────────────────────────────────────────────┐
    // │ GANTI baris email di bawah dengan email akun panitia Anda.        │
    // │ Boleh lebih dari satu, pisahkan dengan koma:                      │
    // │     return ['satu@contoh.go.id', 'dua@contoh.go.id'];             │
    // └───────────────────────────────────────────────────────────────────┘
    function emailAdmin() {
      return [
        'ranirani@gmail.com'
      ];
    }

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email in emailAdmin();
    }

    // ── sesi ujian ──────────────────────────────────────────────────────
    // Dibaca semua orang (lobi peserta memerlukannya), ditulis hanya panitia.
    match /pretestSesi/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── akun peserta ────────────────────────────────────────────────────
    // Dibuat sendiri oleh peserta saat mendaftar; boleh diperbarui bila
    // instansinya berubah. Menghapus hanya boleh oleh panitia.
    match /pretestAkun/{idAkun} {
      allow read: if true;

      allow create, update: if
           request.resource.data.nama is string
        && request.resource.data.nama.size() >= 3
        && request.resource.data.nama.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 160
        && request.resource.data.emailKunci is string
        && request.resource.data.emailKunci == request.resource.data.email.lower()
        && request.resource.data.instansi is string
        && request.resource.data.instansi.size() >= 3
        && request.resource.data.instansi.size() <= 160;

      allow delete: if isAdmin();
    }

    // ── hasil ujian ─────────────────────────────────────────────────────
    match /pretestHasil/{id} {
      allow read: if true;

      allow create: if
           request.resource.data.nama is string
        && request.resource.data.nama.size() >= 3
        && request.resource.data.nama.size() <= 120

        && request.resource.data.email is string
        && request.resource.data.email.size() <= 160
        && request.resource.data.emailKunci is string
        && request.resource.data.emailKunci == request.resource.data.email.lower()

        && request.resource.data.instansi is string
        && request.resource.data.instansi.size() >= 3
        && request.resource.data.instansi.size() <= 160

        && request.resource.data.sesiKode is string
        && request.resource.data.sesiKode.size() <= 40

        && request.resource.data.total is int
        && request.resource.data.total > 0
        && request.resource.data.total <= 30
        && request.resource.data.benar is int
        && request.resource.data.benar >= 0
        && request.resource.data.benar <= request.resource.data.total

        && request.resource.data.skor is int
        && request.resource.data.skor >= 0
        && request.resource.data.skor <= 100

        && request.resource.data.poin is int
        && request.resource.data.poin >= 0
        && request.resource.data.poin <= request.resource.data.total * 1500

        && request.resource.data.durasiDetik is int
        && request.resource.data.durasiDetik >= 0
        && request.resource.data.durasiDetik <= 10800

        && request.resource.data.jawaban is list
        && request.resource.data.jawaban.size() == request.resource.data.total;

      // nilai terkunci begitu terkirim — panitia pun tidak bisa mengubahnya,
      // hanya menghapus rekamannya
      allow update: if false;
      allow delete: if isAdmin();
    }

    // tutup koleksi lain
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
