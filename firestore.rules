rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
// ATURAN FIRESTORE — pre-test BIMTEK eMonDAK
//
// Koleksi yang dipakai
//   pretestAkun/{idAkun}    profil peserta (nama, email, instansi)
//   pretestSesi/aktif       jadwal & token sesi yang sedang berjalan
//   pretestHasil/{auto}     nilai akhir tiap peserta
//   pretestRahasia/admin    sidik jari SHA-256 token admin — TIDAK dapat
//                           dibaca siapa pun; hanya dipakai aturan di bawah
//
// ───────────────────────────────────────────────────────────────────────────
// LANGKAH PEMASANGAN (WAJIB, dua bagian) — proyek bimtek-pfid
//
//  1) ATURAN  ✔ sudah dipasang
//     Console → Firestore Database → Rules → hapus isinya → tempel SELURUH
//     berkas ini → Publish.
//     https://console.firebase.google.com/u/0/project/bimtek-pfid/firestore/rules
//
//  2) DOKUMEN RAHASIA — sekali saja, lewat Firebase Console
//     Firestore Database → Start collection → Collection ID: pretestRahasia
//     → Document ID: admin → Field: hash (string) → isi dengan sidik jari
//     SHA-256 token admin, yaitu nilai yang sama persis dengan `hashAdmin`
//     di assets/konfig.js. Dapatkan dengan:
//         node scripts/hash-token.mjs "TOKEN-ADMIN-ANDA"
//     Tanpa dokumen ini, Ruang Admin TIDAK dapat menyimpan atau membuka sesi
//     (Firestore menolaknya dengan permission-denied) — peserta pun tidak
//     akan pernah bisa masuk. Isian koleksi & dokumen lain dibuat sendiri
//     oleh aplikasi.
//
// ───────────────────────────────────────────────────────────────────────────
// PRINSIPNYA
//  - Peserta masuk tanpa kata sandi dan tanpa Firebase Auth, jadi dokumen
//    boleh dibuat tanpa login — tetapi isinya diperiksa ketat.
//  - Nilai hanya boleh DIBUAT sekali; ubah dan hapus ditolak untuk semua
//    orang. Membersihkan data uji coba dilakukan lewat Firebase Console.
//  - Sesi ujian (buka/tutup, token, jadwal) hanya bisa ditulis oleh yang
//    mengetahui token admin: penulis harus menyertakan field `kunci` berisi
//    SHA-256 token itu, dan aturan membandingkannya dengan dokumen
//    pretestRahasia/admin yang tidak dapat dibaca klien.
//  - Catatan privasi: email peserta ikut tersimpan pada dokumen yang boleh
//    dibaca umum (papan peringkat memerlukan koleksi hasil). Bila email
//    dianggap sensitif, aktifkan Firebase Auth untuk admin lalu ganti
//    `allow read: if true;` dengan aturan berbasis email admin — lihat
//    monev-dak/firestore.rules sebagai contoh.
// ═══════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── sidik jari token admin ──────────────────────────────────────────
    // Diisi manual dari Firebase Console. Klien tidak boleh membaca maupun
    // menulisnya; aturan di bawah tetap dapat memakainya lewat get().
    match /pretestRahasia/{dok} {
      allow read, write: if false;
    }

    function kunciAdminBenar() {
      return request.resource.data.kunci is string
        && request.resource.data.kunci ==
           get(/databases/$(database)/documents/pretestRahasia/admin).data.hash;
    }

    // ── sesi ujian: hanya admin yang boleh mengubah ─────────────────────
    match /pretestSesi/{id} {
      allow read: if true;
      allow write: if kunciAdminBenar();
    }

    // ── akun peserta ────────────────────────────────────────────────────
    // Dibuat sendiri oleh peserta saat mendaftar. Boleh diperbarui (mis.
    // instansi pindah), tetapi tidak boleh dihapus dari aplikasi.
    match /pretestAkun/{idAkun} {
      allow read: if true;

      allow create, update: if
           request.resource.data.nama is string
        && request.resource.data.nama.size() >= 3
        && request.resource.data.nama.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 160
        && request.resource.data.emailKunci is string
        && request.resource.data.emailKunci == request.resource.data.email.lower()
        && request.resource.data.instansi is string
        && request.resource.data.instansi.size() >= 3
        && request.resource.data.instansi.size() <= 160;

      allow delete: if false;
    }

    // ── hasil ujian ─────────────────────────────────────────────────────
    match /pretestHasil/{id} {
      allow read: if true;

      allow create: if
           request.resource.data.nama is string
        && request.resource.data.nama.size() >= 3
        && request.resource.data.nama.size() <= 120

        && request.resource.data.email is string
        && request.resource.data.email.size() <= 160
        && request.resource.data.emailKunci is string
        && request.resource.data.emailKunci == request.resource.data.email.lower()

        && request.resource.data.instansi is string
        && request.resource.data.instansi.size() >= 3
        && request.resource.data.instansi.size() <= 160

        && request.resource.data.sesiKode is string
        && request.resource.data.sesiKode.size() <= 40

        && request.resource.data.total is int
        && request.resource.data.total > 0
        && request.resource.data.total <= 30
        && request.resource.data.benar is int
        && request.resource.data.benar >= 0
        && request.resource.data.benar <= request.resource.data.total

        && request.resource.data.skor is int
        && request.resource.data.skor >= 0
        && request.resource.data.skor <= 100

        && request.resource.data.poin is int
        && request.resource.data.poin >= 0
        && request.resource.data.poin <= request.resource.data.total * 1500

        && request.resource.data.durasiDetik is int
        && request.resource.data.durasiDetik >= 0
        && request.resource.data.durasiDetik <= 10800

        && request.resource.data.jawaban is list
        && request.resource.data.jawaban.size() == request.resource.data.total;

      // nilai terkunci begitu terkirim
      allow update, delete: if false;
    }

    // tutup koleksi lain
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
